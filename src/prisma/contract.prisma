model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model CalculationHistory {
  id         String   @id @default(uuid())
  userId     String
  moduleType String   
  title      String   
  inputs     Json     // Added field
  results    Json     // Added field
  createdAt  DateTime @default(now())
}